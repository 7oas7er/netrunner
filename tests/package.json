{
  "name": "netrunner-tests",
  "private": true,
  "type": "module",
  "scripts": {
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node --test --test-reporter=spec --experimental-test-coverage --test-coverage-include=../netrunner/js/generators.js --test-coverage-include=../netrunner/js/catalog.js unit/*.test.mjs",
    "test:e2e": "playwright test",
    "test:e2e:install": "playwright install --with-deps chromium",
    "serve": "node static-server.mjs ../netrunner -l 4173"
  },
  "devDependencies": {
    "@playwright/test": "1.65.0"
  },
  "engines": {
    "node": ">=20"
  }
}
